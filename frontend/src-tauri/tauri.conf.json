{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiSync",
  "version": "0.1.4",
  "identifier": "com.aisync.app",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/tauri_dev.ps1",
    "beforeBuildCommand": "powershell -ExecutionPolicy Bypass -File ../scripts/tauri_build.ps1",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AiSync",
        "width": 1280,
        "height": 800
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico"
    ],
    "targets": "all",
    "resources": {
      "resources/backend-src/": "backend-src/",
      "resources/runtime/": "runtime/"
    }
  }
}
