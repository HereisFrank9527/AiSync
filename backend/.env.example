# AiSync 后端配置
# 复制此文件为 .env 并填入你的 API Key

# --- LLM 提供商 ---
# 可选: anthropic | openai | custom
LLM_PROVIDER=anthropic

# --- API Key ---
# LLM_API_KEY_ENV 指定「哪个环境变量存放 key」
LLM_API_KEY_ENV=ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=sk-ant-xxx-替换为你的key

# --- 模型名称 ---
LLM_MODEL_NAME=claude-opus-4-7

# --- 自定义 API 地址 (OpenAI 兼容 / 代理) ---
# LLM_API_BASE=https://api.deepseek.com/v1

# --- 思考模式 (仅 Anthropic Claude) ---
LLM_ENABLE_THINKING=true
LLM_EFFORT=high

# --- Prompt 缓存 (仅 Anthropic) ---
LLM_PROMPT_CACHE=true

# --- 项目数据目录 ---
PROJECTS_ROOT=./projects

# ============================================
# 示例: 使用 OpenAI
# ============================================
# LLM_PROVIDER=openai
# LLM_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=sk-xxx
# LLM_MODEL_NAME=gpt-4o
# LLM_ENABLE_THINKING=false

# ============================================
# 示例: 使用 DeepSeek
# ============================================
# LLM_PROVIDER=custom
# LLM_API_KEY_ENV=DEEPSEEK_API_KEY
# DEEPSEEK_API_KEY=sk-xxx
# LLM_API_BASE=https://api.deepseek.com/v1
# LLM_MODEL_NAME=deepseek-chat
# LLM_ENABLE_THINKING=false
