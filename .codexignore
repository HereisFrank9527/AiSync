# Claude Code ignore file for AiSync
# Keep source, configs, lockfiles, and project docs visible; hide generated/runtime/heavy files.

# ===== Python caches / build =====
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.whl

# ===== Virtual environments =====
.conda/
.venv/
venv/
env/

# ===== Node / Vite =====
node_modules/
**/node_modules/
frontend/dist/
frontend/.vite/
frontend/.turbo/
frontend/coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Rust / Tauri generated =====
target/
**/target/
frontend/src-tauri/gen/
frontend/src-tauri/.tauri/
frontend/src-tauri/Cargo.lock.tmp
frontend/src-tauri/resources/backend/*
!frontend/src-tauri/resources/backend/.gitkeep
frontend/src-tauri/resources/backend-src/
frontend/src-tauri/resources/runtime/
.runtime-cache/

# ===== App runtime / user projects =====
presets.json
backend/presets.json
projects/
backend/projects/
**/.aisync/
**/.vectordb/
chroma/
*.log
operation.log
*.sqlite
*.sqlite3
*.db

# ===== Secrets / local env =====
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
*.pfx
credentials*.json
secrets*.json

# ===== Editor / OS =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ===== Claude/transcript local state =====
.claude/
